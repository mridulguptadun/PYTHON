    count = 0

    while n != 0:
        n //= 10
        count += 1

    print("Number of digits =", count)


# 24. Sum of digits
def func24():
    n = int(input("Enter number: "))
    total = 0

    while n != 0:
        digit = n % 10
        total += digit
        n //= 10

    print("Sum of digits =", total)


# 25. Reverse number
def func25():
    n = int(input("Enter number: "))
    reverse = 0

    while n != 0:
        digit = n % 10
        reverse = reverse * 10 + digit
        n //= 10

    print("Reverse =", reverse)


# 26. Palindrome number
def func26():
    n = int(input("Enter number: "))

    original = n
    reverse = 0

    while n != 0:
        digit = n % 10
        reverse = reverse * 10 + digit
        n //= 10

    if original == reverse:
        print("Palindrome")
    else:
        print("Not Palindrome")


# 27. Prime number
def func27():
    n = int(input("Enter number: "))

    if n < 2:
        print("Not Prime")
        return

    for i in range(2, n):
        if n % i == 0:
            print("Not Prime")
            return

    print("Prime")


# 28. Print prime numbers
def func28():
    n = int(input("Enter limit: "))

    for num in range(2, n + 1):
        prime = True

        for i in range(2, num):
            if num % i == 0:
                prime = False
                break

        if prime:
            print(num)


