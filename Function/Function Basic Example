# 30. Find HCF / GCD
def func30():
    a = int(input("Enter first number: "))
    b = int(input("Enter second number: "))

    while b != 0:
        a, b = b, a % b

    print("HCF =", a)


# 31. Find LCM
def func31():
    a = int(input("Enter first number: "))
    b = int(input("Enter second number: "))

    x = a
    y = b

    while y != 0:
        x, y = y, x % y

    hcf = x
    lcm = abs(a * b) // hcf

    print("LCM =", lcm)


