👉 Student Marks Program (Hard)
    students = [
        ["Rahul", 85],
        ["Aman", 90],
        ["Neha", 95],
        ["Priya", 88]
    ]
    highest = students[0]
    for student in students:
        if student[1] > highest[1]:
            highest = student
    print("Topper Name :", highest[0])
    print("Marks :", highest[1])

👉 Matrix Addition (Hard)
    A = [
        [1, 2],
        [3, 4]
    ]
    B = [
        [5, 6],
        [7, 8]
    ]
    result = []
    for i in range(len(A)):
        row = []
        for j in range(len(A[0])):
            row.append(A[i][j] + B[i][j])
        result.append(row)
    print(result)
    Output
    [[6, 8], [10, 12]]

👉 Shopping Cart Project (Mini Project)
    cart = []
    while True:
        print("\n1. Add Item")
        print("2. Remove Item")
        print("3. View Cart")
        print("4. Exit")
        choice = input("Enter Choice: ")
    
        if choice == "1":
            item = input("Enter Item: ")
            cart.append(item)
    
        elif choice == "2":
            item = input("Enter Item to Remove: ")
            if item in cart:
                cart.remove(item)
            else:
                print("Item Not Found!")
    
        elif choice == "3":
            print("Cart:", cart)
    
        elif choice == "4":
            break
        else:
            print("Invalid Choice!")
