    print("Largest =", largest)

👉 Count Even and Odd Numbers
    numbers = [10, 15, 20, 33, 40]
    even = 0
    odd = 0
    for num in numbers:
        if num % 2 == 0:
            even += 1
        else:
            odd += 1
    print("Even =", even)
    print("Odd =", odd)

